[Unit]
Description=Read-only Palo Alto (PAN-OS / Panorama) MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paloalto-mcp
Group=paloalto-mcp
WorkingDirectory=/opt/paloalto-mcp
EnvironmentFile=/etc/paloalto-mcp/paloalto-mcp.env
# Credentials are loaded by systemd and exposed only to this service via $CREDENTIALS_DIRECTORY. The LoadCredential= lines
# are generated by sync-credentials.sh into a drop-in (credentials.conf) from the files in /etc/paloalto-mcp/credentials.
ExecStart=/opt/paloalto-mcp/venv/bin/python -m app.main
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/log/paloalto-mcp

[Install]
WantedBy=multi-user.target
