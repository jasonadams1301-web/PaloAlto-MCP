MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8766
INVENTORY_FILE=/etc/paloalto-mcp/inventory.yaml
AUDIT_LOG=/var/log/paloalto-mcp/audit.log
# Pinned device certificates live here as <endpoint name>.pem (see scan-cert.py). Devices with tls: ca use PANOS_CA_BUNDLE.
PANOS_CERT_DIR=/etc/paloalto-mcp/certs
#PANOS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
PANOS_TIMEOUT_SECONDS=30
PANOS_MAX_PARALLEL=6
# Firewall configurations hold password hashes, pre-shared keys and SNMP communities, so they are redacted by default.
# Set to false to return configuration unfiltered.
CONFIG_REDACT=true
LOG_LEVEL=INFO
# API keys are NOT set here. They are systemd credentials (see paloalto-mcp.service and README).
